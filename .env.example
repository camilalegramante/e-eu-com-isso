# Variáveis de ambiente (defina na Vercel em Project Settings > Environment Variables).

# URL pública final do site (use o domínio definitivo quando tiver).
# Se não definir, o site usa automaticamente a URL do deploy da Vercel.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com

# Mostrar conteúdo ainda em "rascunho" num deploy, para revisão interna.
# Deixe ausente ou "false" no deploy público/produção real.
NEXT_PUBLIC_SHOW_DRAFTS=false
